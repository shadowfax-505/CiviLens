{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai": {},
    "opencode": {}
  },
  "mcp": {
    "opencode-vision": {
      "type": "local",
      "command": ["node", ".opencode/opencode-vision-mcp/server.js"],
      "enabled": true,
      "environment": {
        "OPENROUTER_API_KEY": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "agent": {
    "orchestrator": {
      "description": "Team lead - plans, delegates, reviews, integrates all work",
      "mode": "primary",
      "model": "opencode/deepseek-v4-flash-free",
      "prompt": "{file:../prompts/orchestrator.txt}",
      "permission": {
        "task": {
          "architect": "allow",
          "ui-component": "allow",
          "stylist": "allow",
          "state-mgmt": "allow",
          "api-designer": "allow",
          "db-schema": "allow",
          "auth-handler": "allow",
          "validator": "allow",
          "unit-tester": "allow",
          "integration-tester": "allow",
          "e2e-tester": "allow",
          "mock-fixtures": "allow",
          "code-reviewer": "allow",
          "security-auditor": "allow",
          "perf-optimizer": "allow",
          "debugger": "allow",
          "refactorer": "allow",
          "migration-script": "allow",
          "ci-cd": "allow",
          "docs-writer": "allow",
          "explore": "allow",
          "general": "allow"
        }
      },
      "color": "primary"
    },
    "build": {
      "description": "Full-access dev agent for hands-on work",
      "mode": "primary",
      "model": "opencode/nemotron-3-ultra-free",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "plan": {
      "description": "Read-only planning, architecture, and analysis",
      "mode": "primary",
      "model": "openai/gpt-5.5",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "architect": {
      "description": "System design, component hierarchy, data flow architecture",
      "mode": "subagent",
      "model": "openai/gpt-5.3-codex",
      "prompt": "{file:../prompts/architect.txt}",
      "color": "#8e44ad",
      "permission": {
        "edit": "deny"
      }
    },
    "ui-component": {
      "description": "React/Vue/Svelte component implementation - props, events, lifecycle",
      "mode": "subagent",
      "model": "openai/gpt-5.4",
      "prompt": "{file:../prompts/ui-component.txt}",
      "color": "#61dafb"
    },
    "stylist": {
      "description": "CSS, Tailwind, responsive layout, animations, themes",
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "prompt": "{file:../prompts/stylist.txt}",
      "color": "#e84393"
    },
    "state-mgmt": {
      "description": "State management - Redux, Zustand, Context, React Query, signals",
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "prompt": "{file:../prompts/state-mgmt.txt}",
      "color": "#00cec9"
    },
    "api-designer": {
      "description": "REST/GraphQL endpoint design, route handlers, request/response shapes",
      "mode": "subagent",
      "model": "openai/gpt-5.2-codex",
      "prompt": "{file:../prompts/api-designer.txt}",
      "color": "#00b894"
    },
    "db-schema": {
      "description": "Database schemas, tables, indexes, migrations, query optimization",
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "prompt": "{file:../prompts/db-schema.txt}",
      "color": "#0984e3"
    },
    "auth-handler": {
      "description": "Authentication - JWT, OAuth, sessions, password hashing, RBAC, MFA",
      "mode": "subagent",
      "model": "opencode/mimo-v2.5-free",
      "prompt": "{file:../prompts/auth-handler.txt}",
      "color": "#d63031"
    },
    "validator": {
      "description": "Input validation, schema validation, sanitization, type guards",
      "mode": "subagent",
      "model": "opencode/big-pickle",
      "prompt": "{file:../prompts/validator.txt}",
      "color": "#636e72"
    },
    "unit-tester": {
      "description": "Unit tests - Jest, Vitest, Mocha, coverage, mocking, snapshot tests",
      "mode": "subagent",
      "model": "openai/gpt-5.4-mini",
      "prompt": "{file:../prompts/unit-tester.txt}",
      "color": "#a29bfe"
    },
    "integration-tester": {
      "description": "Integration tests - API tests, DB tests, service-level tests, fixtures",
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "prompt": "{file:../prompts/integration-tester.txt}",
      "color": "#6c5ce7"
    },
    "e2e-tester": {
      "description": "E2E tests - Playwright, Cypress, user flows, visual regression",
      "mode": "subagent",
      "model": "opencode/mimo-v2.5-free",
      "prompt": "{file:../prompts/e2e-tester.txt}",
      "color": "#fd79a8"
    },
    "mock-fixtures": {
      "description": "Mock data, test fixtures, factory functions, seed data generators",
      "mode": "subagent",
      "model": "opencode/north-mini-code-free",
      "prompt": "{file:../prompts/mock-fixtures.txt}",
      "color": "#b2bec3"
    },
    "code-reviewer": {
      "description": "Code review - best practices, anti-patterns, code quality, standards",
      "mode": "subagent",
      "model": "openai/gpt-5.3-codex",
      "prompt": "{file:../prompts/code-reviewer.txt}",
      "color": "#fdcb6e",
      "permission": {
        "edit": "deny"
      }
    },
    "security-auditor": {
      "description": "Security audit - vulns, XSS, SQLi, CSRF, dependency checks, CSP",
      "mode": "subagent",
      "model": "opencode/nemotron-3-ultra-free",
      "prompt": "{file:../prompts/security-auditor.txt}",
      "color": "#e17055",
      "permission": {
        "edit": "deny"
      }
    },
    "perf-optimizer": {
      "description": "Performance optimization - bundle size, lazy loading, caching, memoization",
      "mode": "subagent",
      "model": "opencode/big-pickle",
      "prompt": "{file:../prompts/perf-optimizer.txt}",
      "color": "#55efc4"
    },
    "debugger": {
      "description": "Root cause analysis, stack traces, crash fixes, logging, reproduction",
      "mode": "subagent",
      "model": "openai/gpt-5.1-codex",
      "prompt": "{file:../prompts/debugger.txt}",
      "color": "#e74c3c"
    },
    "refactorer": {
      "description": "Code refactoring - extract functions, simplify logic, reduce duplication",
      "mode": "subagent",
      "model": "openai/gpt-5.4",
      "prompt": "{file:../prompts/refactorer.txt}",
      "color": "#f39c12"
    },
    "migration-script": {
      "description": "Data migrations, schema migrations, codemods, version upgrades",
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "prompt": "{file:../prompts/migration-script.txt}",
      "color": "#2d3436"
    },
    "ci-cd": {
      "description": "CI/CD configs, Docker, GitHub Actions, build tooling, env setup",
      "mode": "subagent",
      "model": "opencode/nemotron-3-ultra-free",
      "prompt": "{file:../prompts/ci-cd.txt}",
      "color": "#00b894"
    },
    "docs-writer": {
      "description": "README, API docs, JSDoc, inline comments, changelogs, setup guides",
      "mode": "subagent",
      "model": "opencode/north-mini-code-free",
      "prompt": "{file:../prompts/docs-writer.txt}",
      "color": "#0984e3"
    }
  },
  "default_agent": "orchestrator",
  "model": "opencode/nemotron-3-ultra-free",
  "small_model": "opencode/deepseek-v4-flash-free"
}
