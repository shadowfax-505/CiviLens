APP_NAME=CivicLens
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_VERSION=v1.0.0
APP_COMMIT=local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_STRUCTURED_CHANNEL=structured
PERFORMANCE_TIMING_ENABLED=true

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=civiclens
# DB_USERNAME=root
# DB_PASSWORD=

# MySQL is the planned production database for CivicLens v1.
# Use these values when running MySQL locally.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=civiclens
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
QUEUE_NOTIFICATIONS=notifications
QUEUE_REPORTS=reports
QUEUE_EXPORTS=exports
QUEUE_OCR=ocr
QUEUE_AI=ai
QUEUE_SEARCH=search
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FILESYSTEM_CLOUD=s3
DOCUMENT_STORAGE_DISK=local
DOCUMENT_MAX_UPLOAD_KB=20480
SEARCH_PROVIDER=database
SEARCH_CACHE_TTL_MINUTES=10
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@civiclens.local
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CIVICLENS_VERSION=v1.0.0
CIVICLENS_V2_FEATURES=false
MAP_PUBLIC_MARKER_LIMIT=250
MAP_ADMIN_MARKER_LIMIT=500
MAP_DEFAULT_LATITUDE=23.685
MAP_DEFAULT_LONGITUDE=90.3563
MAP_MAX_VIEWPORT_LATITUDE_SPAN=30
MAP_MAX_VIEWPORT_LONGITUDE_SPAN=30
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
