APP_NAME=CivicLens
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://civiclens.example
APP_VERSION=v1.0.0
APP_COMMIT=release-sha

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
LOG_STRUCTURED_CHANNEL=structured
PERFORMANCE_TIMING_ENABLED=true

DB_CONNECTION=mysql
DB_HOST=managed-mysql.example.internal
DB_PORT=3306
DB_DATABASE=civiclens
DB_USERNAME=civiclens
DB_PASSWORD=
# Required only when using the opt-in bundled MySQL profile.
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

QUEUE_CONNECTION=database
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=managed-redis.example.internal
REDIS_PASSWORD=
REDIS_PORT=6379

FILESYSTEM_DISK=local
FILESYSTEM_CLOUD=s3
DOCUMENT_STORAGE_DISK=local
DOCUMENT_MAX_UPLOAD_KB=20480
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

SEARCH_PROVIDER=database
SEARCH_CACHE_TTL_MINUTES=10

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.gov
MAIL_FROM_NAME="${APP_NAME}"

CIVICLENS_VERSION=v1.0.0
CIVICLENS_V2_FEATURES=false
CIVICLENS_EARTH_JOURNEY_ENABLED=false
# Leave empty in production. Seeders must stay blocked; reference data ships via migrations.
CIVICLENS_SEEDING_ENVIRONMENTS=
CIVICLENS_SEEDING_PASSWORD=
MAP_PUBLIC_MARKER_LIMIT=250
MAP_ADMIN_MARKER_LIMIT=500
MAP_DEFAULT_LATITUDE=23.685
MAP_DEFAULT_LONGITUDE=90.3563
MAP_MAX_VIEWPORT_LATITUDE_SPAN=30
MAP_MAX_VIEWPORT_LONGITUDE_SPAN=30
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"
