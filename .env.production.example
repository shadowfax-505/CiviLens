APP_NAME=CivicLens
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://civiclens.example
APP_VERSION=v1.0.0-RC1
APP_COMMIT=release-sha

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
LOG_STRUCTURED_CHANNEL=structured
PERFORMANCE_TIMING_ENABLED=true

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=civiclens
DB_USERNAME=civiclens
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-root
MYSQL_DATABASE=civiclens
MYSQL_USER=civiclens
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

QUEUE_CONNECTION=database
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=local
FILESYSTEM_CLOUD=s3
DOCUMENT_STORAGE_DISK=local
DOCUMENT_MAX_UPLOAD_KB=20480

SEARCH_PROVIDER=database
SEARCH_CACHE_TTL_MINUTES=10

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.gov
MAIL_FROM_NAME="${APP_NAME}"

CIVICLENS_VERSION=v1.0.0-RC1
CIVICLENS_V2_FEATURES=false
MAP_PUBLIC_MARKER_LIMIT=250
MAP_ADMIN_MARKER_LIMIT=500
MAP_DEFAULT_LATITUDE=23.685
MAP_DEFAULT_LONGITUDE=90.3563
MAP_MAX_VIEWPORT_LATITUDE_SPAN=30
MAP_MAX_VIEWPORT_LONGITUDE_SPAN=30
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"
